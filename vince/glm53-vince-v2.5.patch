+# TF_GLM_PF_TAP_TAIL=1 (prefill work 2026-11-10, start time, default 0): a prompt chunk longer than the drafter's ring
+# commits only its last rows' taps (whole launches of t_max rows covering at least the ring): the earlier rows' ring
+# slots are overwritten by them in the same commit, rows are independent and the kept rows run in the same launches
+# as before, so the ring ends with the same bits. A 6,144-row chunk: 17 launches instead of 48.
+PF_TAP_TAIL = (__import__("os").environ.get("TF_GLM_PF_TAP_TAIL", "0").strip() or "0") == "1"
+
+
+def tap_skip(drafter, n: int) -> int:
+    """How many of a chunk's n leading rows need no context update (0 unless TF_GLM_PF_TAP_TAIL=1 on a ring)."""
+
+    owner, ring = getattr(drafter, "owner", None), getattr(drafter, "ring", 0)
+    if not PF_TAP_TAIL or owner is None or not ring or n <= ring:
+        return 0
+    return (n - ring) // owner.t_max * owner.t_max
