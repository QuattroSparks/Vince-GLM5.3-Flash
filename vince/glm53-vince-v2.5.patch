diff --git a/tensorfold/families/glm5_next/cuda/pf_dequant.cu b/tensorfold/families/glm5_next/cuda/pf_dequant.cu
new file mode 100644
index 0000000..55fea27
--- /dev/null
+++ b/tensorfold/families/glm5_next/cuda/pf_dequant.cu
@@ -0,0 +1,82 @@
+// Prefill work (2026-11-08): a Q4 weight (qmm.Q4: int32 words [n/64][k/gs][8][32][gs/32], bf16 scales and biases
+// [k/gs][npad]) as a plain bf16 matrix W [npad, K] (row n = output column n, K contiguous), each value made by exactly
+// the ops qmm_prefill.cu's prefill_kernel feeds its mma: bf16(fma.rn.bf16x2(pair(word, shift), (s, s), (b, b))).
+// A GEMM that runs the same m16n8k16 bf16 mma over k16 steps 0, 16, 32, ... into one fp32 chain then gives the
+// prefill kernel's bits.
+#include <ATen/ATen.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <cuda_bf16.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+
+namespace {
+
+__device__ __forceinline__ uint32_t pair(uint32_t w, int s) {     // qmm_frag::pair (sm_90+ form)
+    const uint32_t t = ((w >> s) & 0x000F000Fu) | 0x43004300u;
+    uint32_t r;
+    asm("sub.rn.bf16x2 %0, %1, %2;\n" : "=r"(r) : "r"(t), "r"(0x43004300u));
+    return r;
+}
+
+__device__ __forceinline__ uint32_t fma2(uint32_t a, uint32_t b, uint32_t c) {   // qmm_prefill.cu's fma2
+    uint32_t d;
+    asm("fma.rn.bf16x2 %0, %1, %2, %3;\n" : "=r"(d) : "r"(a), "r"(b), "r"(c));
+    return d;
+}
+
+// One thread a (tile t, group g, n8 block j, lane): its GS/32 words hold, for each k16 step kt of the group, the
+// B fragment (b0, b1) of column n = t*64 + j*8 + lane/4 at rows k = g*GS + kt*16 + 2*(lane%4) + {0, 1} (b0) and
+// + 8 + {0, 1} (b1), as the mma's B fragment layout puts them.
+template <int GS>
+__global__ void dequant_kernel(const uint32_t* __restrict__ w, const uint16_t* __restrict__ scales,
+                               const uint16_t* __restrict__ biases, uint16_t* __restrict__ out, int K, int npad,
+                               int tiles) {
+    const int KG = K / GS;
+    const long long idx = (long long)blockIdx.x * blockDim.x + threadIdx.x;      // over tiles * KG * 8 * 32
+    const long long total = (long long)tiles * KG * 8 * 32;
+    if (idx >= total) return;
+    const int lane = (int)(idx & 31);
+    const int j = (int)((idx >> 5) & 7);
+    const long long tg = idx >> 8;                 // t * KG + g
+    const int g = (int)(tg % KG);
+    const int t = (int)(tg / KG);
+    const uint32_t* src = w + idx * (GS / 32);     // [t][g][j][lane][GS/32]
+    const int n = t * 64 + j * 8 + (lane >> 2);
+    const uint32_t s = (uint32_t)scales[(size_t)g * npad + n] * 0x10001u;
+    const uint32_t b = (uint32_t)biases[(size_t)g * npad + n] * 0x10001u;
+    uint16_t* row = out + (size_t)n * K + (size_t)g * GS + 2 * (lane & 3);
+#pragma unroll
+    for (int kt = 0; kt < GS / 16; ++kt) {
+        const uint32_t word = src[kt / 2];
+        const uint32_t b0 = fma2(pair(word, (kt & 1) * 8), s, b);
+        const uint32_t b1 = fma2(pair(word, (kt & 1) * 8 + 4), s, b);
+        *reinterpret_cast<uint32_t*>(row + kt * 16) = b0;          // k, k + 1 (low half first)
+        *reinterpret_cast<uint32_t*>(row + kt * 16 + 8) = b1;      // k + 8, k + 9
+    }
+}
+
+}  // namespace
+
+void pf_dequant_q4_cuda(const at::Tensor& weight, const at::Tensor& scales, const at::Tensor& biases, at::Tensor& out,
+                        int64_t K, int64_t gs) {
+    TORCH_CHECK(weight.is_cuda() && weight.scalar_type() == at::kInt && weight.is_contiguous(), "pf_dequant: words");
+    TORCH_CHECK(out.scalar_type() == at::kBFloat16 && out.is_contiguous() && out.size(1) == K, "pf_dequant: out [npad, K]");
+    const int npad = (int)scales.size(1);
+    TORCH_CHECK(out.size(0) >= npad && npad % 64 == 0, "pf_dequant: out rows");
+    const int tiles = npad / 64;
+    const long long total = (long long)tiles * (K / gs) * 8 * 32;
+    const int threads = 256;
+    const unsigned blocks = (unsigned)((total + threads - 1) / threads);
+    auto stream = at::cuda::getCurrentCUDAStream();
+    auto w = reinterpret_cast<const uint32_t*>(weight.data_ptr());
+    auto s = reinterpret_cast<const uint16_t*>(scales.data_ptr());
+    auto b = reinterpret_cast<const uint16_t*>(biases.data_ptr());
+    auto o = reinterpret_cast<uint16_t*>(out.data_ptr());
+    if (gs == 64)
+        dequant_kernel<64><<<blocks, threads, 0, stream>>>(w, s, b, o, (int)K, npad, tiles);
+    else if (gs == 32)
+        dequant_kernel<32><<<blocks, threads, 0, stream>>>(w, s, b, o, (int)K, npad, tiles);
+    else
+        TORCH_CHECK(false, "pf_dequant: group size 32 or 64");
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
diff --git a/tensorfold/families/glm5_next/cuda/pf_gemm.py b/tensorfold/families/glm5_next/cuda/pf_gemm.py
new file mode 100644
index 0000000..8c2b85c
--- /dev/null
+++ b/tensorfold/families/glm5_next/cuda/pf_gemm.py
@@ -0,0 +1,151 @@
+"""Prefill work (2026-11-08), TF_GLM_PF_GEMM=1: a prompt chunk's 4-bit dense projections (``qmm.prefill_matmul``,
+the prefill kernel of qmm_prefill.cu) as a bf16 weight made once by the prefill kernel's own ops (``pf_dequant.cu``)
+and a plain bf16 GEMM that runs the same m16n8k16 mma over k16 steps 0, 16, 32, ... into one fp32 chain: every
+output the prefill kernel's bits (checked bit for bit by micro/pf_gemm_check.py), at a plain GEMM's speed.
+
+The bf16 weights are made per call into a small cache keyed by the Q4 (``Cache``): a prompt chunk's two halves
+(TF_GLM_PROMPT_MICROBATCH) run each layer's projections back to back, so the second half finds the first's."""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+import triton
+import triton.language as tl
+
+ENABLED = os.environ.get("TF_GLM_PF_GEMM", "0") == "1"
+# rows from which a prompt matmul takes this path (fewer: the prefill kernel, whose bits these are anyway)
+MIN_ROWS = int(os.environ.get("TF_GLM_PF_GEMM_MIN_ROWS", "256") or 256)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_glm_pf_dequant_v1", sources=[str(here / "pf_dequant.cpp"), str(here / "pf_dequant.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+def dequant(q, out: torch.Tensor | None = None) -> torch.Tensor:
+    """Q4 -> bf16 [npad, K] (the prefill kernel's B values)."""
+
+    npad = q.scales.shape[1]
+    if out is None:
+        out = torch.empty((npad, q.k), dtype=torch.bfloat16, device=q.weight.device)
+    _ext().dequant_q4(q.weight, q.scales, q.biases, out, q.k, q.gs)
+    return out
+
+
+@triton.jit
+def _gemm(X, W, Y, M, N, K, sxm, swn, sym, BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GM: tl.constexpr,
+          F32: tl.constexpr):
+    pid = tl.program_id(0)
+    npm = tl.cdiv(M, BM)
+    npn = tl.cdiv(N, BN)
+    group = GM * npn
+    gid = pid // group
+    fm = gid * GM
+    gsz = min(npm - fm, GM)
+    pm = fm + (pid % group) % gsz
+    pn = (pid % group) // gsz
+    rm = pm * BM + tl.arange(0, BM)
+    rn = pn * BN + tl.arange(0, BN)
+    rk = tl.arange(0, BK)
+    xm = rm < M
+    xp = X + rm[:, None] * sxm + rk[None, :]
+    wp = W + rn[None, :] * swn + rk[:, None]           # W [N, K]: the (k, n) tile, K contiguous
+    acc = tl.zeros((BM, BN), dtype=tl.float32)
+    for k in range(0, K, BK):
+        a = tl.load(xp, mask=xm[:, None], other=0.0)
+        b = tl.load(wp)
+        acc = tl.dot(a, b, acc)                         # one chain over K, k16 steps in order
+        xp += BK
+        wp += BK
+    yp = Y + rm[:, None] * sym + rn[None, :]
+    ok = xm[:, None] & (rn[None, :] < N)
+    if F32:
+        tl.store(yp, acc, mask=ok)
+    else:
+        tl.store(yp, acc.to(tl.bfloat16), mask=ok)
+
+
+# (BM, BN, BK, stages, warps, GM): the GB10 sweep's best at a rank's prompt shapes (micro/pf_gemm_check.py)
+CONFIG = (128, 128, 32, 4, 4, 8)
+
+
+def gemm(x: torch.Tensor, w: torch.Tensor, n: int, *, f32: bool, out: torch.Tensor | None = None,
+         config: tuple | None = None) -> torch.Tensor:
+    """x [M, K] bf16 @ w[:n]^T (w [npad, K] bf16) -> [M, n] fp32 or bf16."""
+
+    M, K = x.shape
+    if x.stride(1) != 1:
+        x = x.contiguous()
+    if out is None:
+        out = torch.empty((M, n), dtype=torch.float32 if f32 else torch.bfloat16, device=x.device)
+    BM, BN, BK, stages, warps, GM = config or CONFIG
+    if K % BK:
+        raise ValueError(f"pf_gemm: K {K} is not a multiple of {BK}")
+    grid = (triton.cdiv(M, BM) * triton.cdiv(n, BN),)
+    _gemm[grid](x, w, out, M, n, K, x.stride(0), w.stride(0), out.stride(0), BM=BM, BN=BN, BK=BK, GM=GM, F32=f32,
+                num_stages=stages, num_warps=warps)
+    return out
+
+
+class Cache:
+    """The bf16 weights of the last few Q4s a prompt chunk used (by identity), each in a buffer reused once evicted.
+    Every use records an event on the stream that used it; a buffer is rewritten only after its last use's event."""
+
+    def __init__(self, slots: int = 8) -> None:
+        self.slots = slots
+        self.items: dict[int, list] = {}            # key -> [q, buffer, event of the last use]
+        self.order: list[int] = []
+
+    def get(self, q) -> tuple[torch.Tensor, list]:
+        key = id(q)
+        hit = self.items.get(key)
+        npad = q.scales.shape[1]
+        if hit is not None and hit[0] is q:
+            self.order.remove(key)
+            self.order.append(key)
+            torch.cuda.current_stream().wait_event(hit[3])    # made (no-op on the stream that made it)
+            return hit[1][:npad * q.k].view(npad, q.k), hit
+        buf = None
+        if len(self.order) >= self.slots:
+            old = self.order.pop(0)
+            _, buf, ev, _ = self.items.pop(old)
+            if ev is not None:
+                torch.cuda.current_stream().wait_event(ev)    # its last GEMM, on whatever stream, is done first
+            if buf.numel() < npad * q.k:
+                buf = None
+        if buf is None:
+            buf = torch.empty((npad * q.k,), dtype=torch.bfloat16, device=q.weight.device)
+        w = buf[:npad * q.k].view(npad, q.k)
+        dequant(q, w)
+        made = torch.cuda.Event()
+        made.record(torch.cuda.current_stream())
+        item = [q, buf, None, made]
+        self.items[key] = item
+        self.order.append(key)
+        return w, item
+
+    @staticmethod
+    def used(item) -> None:
+        ev = torch.cuda.Event()
+        ev.record(torch.cuda.current_stream())
+        item[2] = ev
+
+
+CACHE = Cache()
+
+
+def prefill_matmul(x: torch.Tensor, q, *, f32: bool = False, out: torch.Tensor | None = None) -> torch.Tensor:
+    """``qmm.prefill_matmul``'s bits through the bf16 weight and the GEMM."""
+
+    w, item = CACHE.get(q)
+    y = gemm(x, w, q.n, f32=f32, out=out)
+    CACHE.used(item)
+    return y
diff --git a/tensorfold/families/glm5_next/cuda/pf_switches.py b/tensorfold/families/glm5_next/cuda/pf_switches.py
